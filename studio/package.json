    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-player": "^2.16.0",
    "sanity": "4.22.0",
    "sanity-codegen": "^0.9.8",
    "sanity-plugin-media": "^3.0.2",
    "sanity-plugin-mux-input": "^3.0.5",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.1.3",
